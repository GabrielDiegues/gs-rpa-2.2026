# ---------------------------------------------------------------
# Rua Acesa — RPA. Copie para .env (o .env nunca vai para o git).
# Nenhuma variável é obrigatória: os valores abaixo são os padrões.
# ---------------------------------------------------------------

# API de visão (repositório gs-computer-vision-2.2026): POST /detect
VISAO_URL=http://localhost:8000
VISAO_TIMEOUT_S=20
VISAO_TENTATIVAS=3
VISAO_BACKOFF_S=1.0
# falhas seguidas que abrem o "circuito" e suspendem chamadas à visão no lote
VISAO_LIMITE_CIRCUITO=3

# GeoSampa (WFS público da Prefeitura) — cadastro oficial de pontos de iluminação
GEOSAMPA_WFS_URL=http://wfs.geosampa.prefeitura.sp.gov.br/geoserver/geoportal/wfs
GEOSAMPA_TIMEOUT_S=10
# distância máxima (m) entre o relato e o poste oficial para associá-los
RAIO_POSTE_M=40
# sem poste associado: relatos a até esta distância (m) são agrupados
RAIO_DEDUP_M=30

# Open-Meteo (sem chave)
CLIMA_URL=https://api.open-meteo.com/v1/forecast
CLIMA_TIMEOUT_S=10

# Limiares do sensor de luz do robô (lux). Referência: ABNT NBR 5101
LDR_LIMIAR_ESCURO_LUX=5
LDR_LIMIAR_FRACO_LUX=15

# Lote e entrada
MAX_LOTE=200
MAX_FOTO_MB=10
MAX_IDADE_RELATO_DIAS=30

# LGPD: salt do hash do contato. Se vazio, um salt aleatório é criado em dados/.salt
SALT_LGPD=
RETENCAO_FOTOS_DIAS=30

# Opcional: endpoint da LLM (componente de GenAI) para redigir a solicitação.
# Vazio = texto gerado por template (sempre disponível).
LLM_URL=
LLM_TIMEOUT_S=30

# Painel de revisão humana
PAINEL_PORTA=8001
